{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Summit Showdown decision request (normalised boundary)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "match_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "round_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "request_tick": {
      "type": "integer",
      "minimum": 0
    },
    "observed_tick": {
      "type": "integer",
      "minimum": 0
    },
    "decision_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_tick": {
      "type": "integer",
      "minimum": 0
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_generation_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "self": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "health": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "stamina": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "meter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "grounded": {
              "type": "boolean"
            },
            "visible_action": {
              "enum": [
                "light",
                "body",
                "heavy",
                "low",
                "overhead",
                "anti_air",
                "air_kick",
                "throw",
                "throw_break",
                "parry",
                "special_veto",
                "special_papers",
                "dash_forward",
                "dash_back",
                "jump",
                "guard_high",
                "guard_low",
                "advance",
                "retreat",
                "crouch",
                "idle",
                "hitstun",
                "knockdown",
                "none"
              ]
            },
            "phase": {
              "enum": [
                "neutral",
                "startup",
                "active",
                "recovery",
                "hitstun",
                "knockdown"
              ]
            },
            "facing": {
              "enum": [
                -1,
                1
              ]
            }
          },
          "required": [
            "health",
            "stamina",
            "meter",
            "grounded",
            "visible_action",
            "phase",
            "facing"
          ]
        },
        "opponent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "health": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "stamina": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "meter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "grounded": {
              "type": "boolean"
            },
            "visible_action": {
              "enum": [
                "light",
                "body",
                "heavy",
                "low",
                "overhead",
                "anti_air",
                "air_kick",
                "throw",
                "throw_break",
                "parry",
                "special_veto",
                "special_papers",
                "dash_forward",
                "dash_back",
                "jump",
                "guard_high",
                "guard_low",
                "advance",
                "retreat",
                "crouch",
                "idle",
                "hitstun",
                "knockdown",
                "none"
              ]
            },
            "phase": {
              "enum": [
                "neutral",
                "startup",
                "active",
                "recovery",
                "hitstun",
                "knockdown"
              ]
            },
            "facing": {
              "enum": [
                -1,
                1
              ]
            }
          },
          "required": [
            "health",
            "stamina",
            "meter",
            "grounded",
            "visible_action",
            "phase",
            "facing"
          ]
        },
        "distance_mm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14000
        },
        "self_to_wall_mm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14000
        },
        "opponent_to_wall_mm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14000
        },
        "self_can_act": {
          "type": "boolean"
        },
        "recent_visible_opponent_actions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "enum": [
              "light",
              "body",
              "heavy",
              "low",
              "overhead",
              "anti_air",
              "air_kick",
              "throw",
              "throw_break",
              "parry",
              "special_veto",
              "special_papers",
              "dash_forward",
              "dash_back",
              "jump",
              "guard_high",
              "guard_low",
              "advance",
              "retreat",
              "crouch",
              "idle"
            ]
          }
        }
      },
      "required": [
        "self",
        "opponent",
        "distance_mm",
        "self_to_wall_mm",
        "opponent_to_wall_mm",
        "self_can_act",
        "recent_visible_opponent_actions"
      ]
    },
    "legal_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "light",
          "body",
          "heavy",
          "low",
          "overhead",
          "anti_air",
          "air_kick",
          "throw",
          "throw_break",
          "parry",
          "special_veto",
          "special_papers",
          "dash_forward",
          "dash_back",
          "jump",
          "guard_high",
          "guard_low",
          "advance",
          "retreat",
          "crouch",
          "idle"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "match_id",
    "round_id",
    "request_tick",
    "observed_tick",
    "decision_epoch",
    "expires_at_tick",
    "policy_version",
    "candidate_generation_version",
    "observation",
    "legal_actions"
  ]
}